{
  "entities": {
    "Project": {
      "title": "Green Hospital Project",
      "description": "A green hospital initiative project with status, budget, evidence, and audit timeline",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "department": { "type": "string" },
        "responsiblePerson": { "type": "string" },
        "status": { "type": "string" },
        "approvalLevel": { "type": "number" },
        "progress": { "type": "number" },
        "budget": { "type": "number" },
        "spent": { "type": "number" },
        "startDate": { "type": "string" },
        "targetDate": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "categoryId", "status", "progress"]
    },
    "Meeting": {
      "title": "Green Hospital Meeting",
      "description": "Meeting record and resolutions for Green & Clean Hospital Committee",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "meetingNumber": { "type": "string" },
        "attendeesCount": { "type": "number" }
      },
      "required": ["id", "title", "date"]
    },
    "NotificationItem": {
      "title": "Notification Item",
      "description": "System alert or workflow notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "date": { "type": "string" },
        "isRead": { "type": "boolean" }
      },
      "required": ["id", "title", "message", "isRead"]
    },
    "AuthorizedUser": {
      "title": "Authorized Personnel",
      "description": "Registered committee members or personnel permitted to access the system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "position": { "type": "string" },
        "department": { "type": "string" },
        "allowedLevels": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "status": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["id", "name", "status"]
    },
    "AccessLogEntry": {
      "title": "Access and Login Log",
      "description": "Audit trail recording which user logged in and their access level and timestamp",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userName": { "type": "string" },
        "level": { "type": "string" },
        "levelLabel": { "type": "string" },
        "loginTime": { "type": "string" },
        "timestampMs": { "type": "number" },
        "deviceInfo": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "userName", "level", "loginTime"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of green hospital projects"
    },
    "/meetings/{meetingId}": {
      "schema": "Meeting",
      "description": "Collection of hospital committee meetings and resolutions"
    },
    "/notifications/{notificationId}": {
      "schema": "NotificationItem",
      "description": "Collection of notifications"
    },
    "/authorized_users/{userId}": {
      "schema": "AuthorizedUser",
      "description": "Collection of authorized users managed by admin"
    },
    "/access_logs/{logId}": {
      "schema": "AccessLogEntry",
      "description": "Collection of access/login history logs"
    }
  }
}
